# Copy to .env (git-ignored) or set in your shell. Nothing here is required for --demo.

# LLM (optional). Without a key the deterministic offline fake LLM is used.
ANTHROPIC_API_KEY=your-anthropic-api-key
CONTENT_ENGINE_WRITER_MODEL=claude-haiku-4-5
CONTENT_ENGINE_JUDGE_MODEL=claude-haiku-4-5

# WordPress REST API with an Application Password (Users > Profile > Application Passwords)
WP_BASE_URL=https://demo-blog.example.com
WP_USER=your-wordpress-username
WP_APP_PASSWORD=your-application-password

# IndexNow (Bing / Copilot). Host the key at https://<your-site>/<key>.txt
INDEXNOW_KEY=your-indexnow-key
